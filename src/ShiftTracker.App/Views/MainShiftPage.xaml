<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShiftTracker.App.Views.MainShiftPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ShiftTracker.App.Controls"
    xmlns:models="clr-namespace:ShiftTracker.App.Models"
    xmlns:viewmodels="clr-namespace:ShiftTracker.App.ViewModels"
    x:DataType="viewmodels:MainShiftViewModel"
    Title="Ca làm"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="Transparent">

    <Grid RowDefinitions="Auto,*">

        <!-- Lớp 1 & 2: Nền hệ thống + Hình nền tùy chỉnh (Custom Wallpaper & Opacity) -->
        <controls:AppWallpaperBackground Grid.RowSpan="2" />

        <!-- ================= HEADER: THÁNG/NĂM, CHUYỂN TUẦN & DẢI 7 NGÀY ================= -->
        <Border
            Grid.Row="0"
            Padding="16,10,16,10"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            Stroke="{DynamicResource PrimaryBorderColor}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,24,24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow
                    Brush="#1A000000"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.14" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="8">

                <!-- Tiêu đề Quản lý lịch + Nút Dark Mode 🌙 + Nút 🎨 Theme + Tổng kết tuần -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                        <Label
                            Text="QUẢN LÝ CA LÀM ✨"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="1.2"
                            TextColor="{DynamicResource PrimaryColor}" />
                        <Label
                            Text="{Binding WeeklySummarySubtitle}"
                            FontSize="11"
                            TextColor="{DynamicResource SecondaryTextColor}" />
                    </VerticalStackLayout>

                    <!-- Nút bật/tắt nhanh Dark Mode (🌙 / ☀️) -->
                    <Border
                        Grid.Column="1"
                        WidthRequest="32"
                        HeightRequest="32"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderColor}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDarkModeQuickCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{Binding DarkModeIcon}"
                            FontSize="13"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Nút mở cài đặt Giao diện & Hình nền (🎨 Theme) -->
                    <Border
                        Grid.Column="2"
                        Padding="8,5"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderColor}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenThemePopupCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label
                                Text="🎨"
                                FontSize="12"
                                VerticalOptions="Center" />
                            <Label
                                Text="Theme"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Padding="9,5"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderColor}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label
                                Text="Tuần:"
                                FontSize="11"
                                TextColor="{DynamicResource SecondaryTextColor}"
                                VerticalOptions="Center" />
                            <Label
                                Text="{Binding WeeklyTotalNetSalaryFormatted}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#059669"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Thanh điều hướng Tuần: 2 nút mũi tên hình vuông bo góc (40x40, CornerRadius=12) -->
                <Grid ColumnDefinitions="40,*,40" VerticalOptions="Center">
                    <Border
                        Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{DynamicResource NavButtonBgColor}"
                        Stroke="{DynamicResource SubtleBorderColor}"
                        StrokeThickness="1"
                        IsEnabled="{Binding CanGoPreviousWeek}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding CanGoPreviousWeek}"
                                Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="‹"
                            FontSize="22"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </Border>

                    <!-- Chạm vào cụm Tháng/Năm để mở Bộ chọn nhanh Tháng / Năm -->
                    <Border
                        Grid.Column="1"
                        Padding="10,2"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenQuickJumpPopupCommand}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout
                            Spacing="1"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label
                                    Text="{Binding CurrentMonthYearTitle}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryTextColor}" />
                                <Label
                                    Text="▾"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label
                                Text="{Binding CurrentWeekRangeText}"
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource SecondaryTextColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="{DynamicResource NavButtonBgColor}"
                        Stroke="{DynamicResource SubtleBorderColor}"
                        StrokeThickness="1"
                        IsEnabled="{Binding CanGoNextWeek}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding CanGoNextWeek}"
                                Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextWeekCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="›"
                            FontSize="22"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </Border>
                </Grid>

                <!-- Dải 7 ngày trên Header (Grid 7 cột hiển thị chuẩn xác T2 -> CN) -->
                <Grid
                    ColumnDefinitions="*,*,*,*,*,*,*"
                    BindableLayout.ItemsSource="{Binding WeekDays}"
                    ColumnSpacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WeekDayItem">
                            <Border
                                Grid.Column="{Binding ColumnIndex}"
                                Padding="0,5"
                                MinimumHeightRequest="56"
                                BackgroundColor="{DynamicResource CardBackgroundColor}"
                                Stroke="{DynamicResource SubtleBorderColor}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="13" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                        <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout
                                    Spacing="1"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{Binding DayOfWeekShort}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource SecondaryTextColor}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label
                                        Text="{Binding DayNumberText}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource PrimaryTextColor}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Chấm tròn nhỏ cho ngày hôm nay (IsToday) + Icon 💎 khi có ca -->
                                    <HorizontalStackLayout
                                        Spacing="3"
                                        MinimumHeightRequest="11"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Ellipse
                                            WidthRequest="5"
                                            HeightRequest="5"
                                            Fill="{DynamicResource PrimaryColor}"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsToday}">
                                            <Ellipse.Triggers>
                                                <DataTrigger
                                                    TargetType="Ellipse"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="Fill" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>

                                        <Label
                                            Text="💎"
                                            FontSize="9"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{DynamicResource PrimaryColor}"
                                            IsVisible="{Binding HasShifts}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- ================= BODY: 7 THẺ NGÀY GIÃN ĐỀU KÍN MÀN HÌNH & SỔ CHI TIẾT ACCORDION ================= -->
        <Grid Grid.Row="1">
            <ScrollView
                Orientation="{Binding BodyScrollOrientation}"
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">

                <Grid
                    RowDefinitions="*,*,*,*,*,*,*"
                    RowSpacing="6"
                    Padding="14,6,14,76"
                    VerticalOptions="Fill"
                    BindableLayout.ItemsSource="{Binding WeekDays}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WeekDayItem">
                            <Border
                                Grid.Row="{Binding ColumnIndex}"
                                Padding="10,6"
                                BackgroundColor="{DynamicResource CardBackgroundColor}"
                                Stroke="{DynamicResource PrimaryBorderColor}"
                                StrokeThickness="1"
                                VerticalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsRestDay}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryCardTintColor}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryCardTintColor}" />
                                        <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <!-- Chạm vào thân thẻ: chọn ngày và sổ/đóng chi tiết (Accordion) nếu ngày có trễ/làm dùm/phạt -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding ToggleExpandCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout
                                    Spacing="6"
                                    VerticalOptions="Center">

                                    <!-- DÒNG CHÍNH TRÊN THẺ (Grid 3 cột: Auto, *, Auto) -->
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="10"
                                        VerticalOptions="Center">

                                        <!-- Cột 1 (Auto): Cụm Thứ/Ngày + Icon (💎 hoặc ☕) -->
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="56"
                                            Padding="4,5"
                                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                                            Stroke="Transparent"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsRestDay}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <VerticalStackLayout
                                                Spacing="1"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <HorizontalStackLayout
                                                    Spacing="2"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        Text="{Binding StatusIcon}"
                                                        FontSize="10"
                                                        TextColor="{DynamicResource PrimaryColor}"
                                                        VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsSelected}"
                                                                Value="True">
                                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Label
                                                        Text="{Binding DayOfWeekShort}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryColor}"
                                                        VerticalOptions="Center">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsRestDay}"
                                                                Value="True">
                                                                <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsSelected}"
                                                                Value="True">
                                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </HorizontalStackLayout>

                                                <Label
                                                    Text="{Binding DateMonthText}"
                                                    FontSize="10"
                                                    HorizontalTextAlignment="Center"
                                                    TextColor="{DynamicResource SecondaryTextColor}">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding IsSelected}"
                                                            Value="True">
                                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Cột 2 (*): Khung giờ làm việc + Icon ngày lễ 🏮 + Tag đồng nghiệp (Ẩn hoàn toàn khi là ngày nghỉ) -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding HasShifts}">

                                            <HorizontalStackLayout
                                                Spacing="5"
                                                VerticalOptions="Center">
                                                <!-- Khung giờ làm (vd: 08:00 - 12:00, 17:00 - 22:00) -->
                                                <Label
                                                    Text="{Binding DayShiftsTimeSummary}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    TextColor="{DynamicResource PrimaryTextColor}"
                                                    VerticalOptions="Center" />

                                                <!-- Icon ngày lễ riêng biệt (🏮 Lễ) -->
                                                <Border
                                                    Padding="5,1"
                                                    BackgroundColor="{DynamicResource HolidayBadgeBgColor}"
                                                    Stroke="#D4AF37"
                                                    StrokeThickness="1"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasHolidayShift}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                        Text="🏮 Lễ"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryColor}" />
                                                </Border>

                                                <!-- Chỉ báo có chi tiết để sổ ra (▾) -->
                                                <Label
                                                    Text="▾"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource AccentColor}"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasExpandableDetails}" />
                                            </HorizontalStackLayout>

                                            <!-- Danh sách tag đồng nghiệp [Lan] [Tuấn] và chỉ báo OT -->
                                            <HorizontalStackLayout
                                                Spacing="5"
                                                VerticalOptions="Center">

                                                <HorizontalStackLayout
                                                    Spacing="4"
                                                    BindableLayout.ItemsSource="{Binding CoworkerTags}"
                                                    IsVisible="{Binding HasCoworkerTags}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border
                                                                Padding="7,2"
                                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                                Stroke="{DynamicResource PrimaryBorderColor}"
                                                                StrokeThickness="1">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12" />
                                                                </Border.StrokeShape>
                                                                <Label
                                                                    Text="{Binding .}"
                                                                    FontSize="10"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{DynamicResource PrimaryColor}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>

                                                <Label
                                                    Text="{Binding DayOtFormatted}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource PrimaryColor}"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasDayOt}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Cột 3 (Auto): Số tiền màu Xanh ngọc lục bảo (#059669), Thời lượng và Nút Chỉnh sửa ✏️ -->
                                        <HorizontalStackLayout
                                            Grid.Column="2"
                                            Spacing="8"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                            <VerticalStackLayout
                                                Spacing="1"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding DayNetSalaryFormatted}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="#059669">
                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding IsRestDay}"
                                                            Value="True">
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="FontAttributes" Value="None" />
                                                            <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <Label
                                                    Text="{Binding DayTotalHoursFormatted}"
                                                    FontSize="11"
                                                    HorizontalTextAlignment="End"
                                                    TextColor="{DynamicResource SecondaryTextColor}"
                                                    IsVisible="{Binding HasShifts}" />
                                            </VerticalStackLayout>

                                            <!-- Nút Chỉnh sửa nhỏ gọn ở góc phải thẻ -->
                                            <Border
                                                Padding="7,5"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBorderColor}"
                                                StrokeThickness="1"
                                                VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding EditCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label
                                                    Text="✏️ Sửa"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource PrimaryColor}"
                                                    VerticalOptions="Center" />
                                            </Border>
                                        </HorizontalStackLayout>

                                    </Grid>

                                    <!-- BOX CHI TIẾT SỔ XUỐNG (ACCORDION): chỉ hiện khi ngày có Trễ / Làm dùm / Phạt và đang mở -->
                                    <Border
                                        Padding="10,7"
                                        BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                                        Stroke="{DynamicResource PrimaryBorderColor}"
                                        StrokeThickness="1"
                                        IsVisible="{Binding ShowExpandedDetails}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="3">
                                            <Label
                                                Text="{Binding LateDetailText}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource PrimaryColor}"
                                                IsVisible="{Binding HasDayLate}" />

                                            <Label
                                                Text="{Binding CoverDetailText}"
                                                FontSize="11"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                IsVisible="{Binding HasDayCover}" />

                                            <Label
                                                Text="{Binding OtherPenaltyDetailText}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource AccentColor}"
                                                IsVisible="{Binding HasOtherPenalty}" />
                                        </VerticalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </ScrollView>

            <!-- Thanh điều hướng dưới cùng dạng viên thuốc nổi (Floating Pill Bar) -->
            <controls:FloatingNavBar
                ActiveTab="Shift"
                VerticalOptions="End" />
        </Grid>

        <!-- ================= POPUP CHỌN NHANH THÁNG / NĂM (QUY TẮC ±10 NĂM & LƯỚI 3X3 + 3X4) ================= -->
        <Grid
            Grid.RowSpan="2"
            BackgroundColor="#66000000"
            IsVisible="{Binding IsQuickJumpPopupOpen}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseQuickJumpPopupCommand}" />
            </Grid.GestureRecognizers>

            <Border
                Margin="20"
                Padding="18"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Stroke="{DynamicResource PrimaryBorderColor}"
                StrokeThickness="1.5"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="📅 Chọn nhanh Tháng / Năm"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryTextColor}" />
                            <Label
                                Text="Nhảy trực tiếp đến kỳ lịch mong muốn (phạm vi ±10 năm)"
                                FontSize="12"
                                TextColor="{DynamicResource SecondaryTextColor}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="32"
                            HeightRequest="32"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseQuickJumpPopupCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="✕"
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                        </Border>
                    </Grid>

                    <!-- Khu vực Chọn Năm: Bộ điều hướng thông minh [ < ] [ 2026 ] [ > ] kèm lưới 3x3 các năm xung quanh -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                Text="{Binding AllowedYearRangeLabel}"
                                FontSize="12"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                TextColor="{DynamicResource SecondaryTextColor}" />

                            <!-- Bộ điều hướng 9 năm [ < ] [ Giai đoạn 9 năm ] [ > ] -->
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="{DynamicResource NavButtonBgColor}"
                                    Stroke="{DynamicResource SubtleBorderColor}"
                                    StrokeThickness="1"
                                    IsEnabled="{Binding CanDecrementYearPage}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding CanDecrementYearPage}"
                                            Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DecrementYearPageCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="‹"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource PrimaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding CanDecrementYearPage}"
                                                Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border
                                    Padding="12,6"
                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                    Stroke="{DynamicResource PrimaryColor}"
                                    StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label
                                        Text="{Binding YearPageRangeLabel}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                </Border>

                                <Border
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="{DynamicResource NavButtonBgColor}"
                                    Stroke="{DynamicResource SubtleBorderColor}"
                                    StrokeThickness="1"
                                    IsEnabled="{Binding CanIncrementYearPage}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding CanIncrementYearPage}"
                                            Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding IncrementYearPageCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="›"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource PrimaryColor}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding CanIncrementYearPage}"
                                                Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Lưới 3x3 các năm xung quanh để chạm chọn nhanh (không cuộn ngang cụt chữ) -->
                        <Grid
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnDefinitions="*,*,*"
                            RowSpacing="6"
                            ColumnSpacing="6"
                            BindableLayout.ItemsSource="{Binding QuickYears}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:QuickYearItem">
                                    <Border
                                        Grid.Row="{Binding RowIndex}"
                                        Grid.Column="{Binding ColumnIndex}"
                                        Padding="0,8"
                                        BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                                        Stroke="{DynamicResource SubtleBorderColor}"
                                        StrokeThickness="1"
                                        IsEnabled="{Binding IsEnabled}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsEnabled}"
                                                Value="False">
                                                <Setter Property="Opacity" Value="0.28" />
                                            </DataTrigger>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                                <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            Text="{Binding Label}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center"
                                            TextColor="{DynamicResource PrimaryTextColor}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsEnabled}"
                                                    Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Khu vực Chọn Tháng: Lưới 3x4 (Th.01 -> Th.12) -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Chọn Tháng (1 - 12):"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource SecondaryTextColor}" />

                        <Grid
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnDefinitions="*,*,*,*"
                            RowSpacing="6"
                            ColumnSpacing="6"
                            BindableLayout.ItemsSource="{Binding QuickMonths}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:QuickMonthItem">
                                    <Border
                                        Grid.Row="{Binding RowIndex}"
                                        Grid.Column="{Binding ColumnIndex}"
                                        Padding="0,9"
                                        BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                                        Stroke="{DynamicResource SubtleBorderColor}"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                                <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            Text="{Binding Label}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalOptions="Center"
                                            TextColor="{DynamicResource PrimaryTextColor}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Nút Đến hôm nay & Xác nhận -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,0">
                        <Button
                            Grid.Column="0"
                            Text="Đến hôm nay"
                            Command="{Binding JumpToTodayCommand}"
                            HeightRequest="44"
                            CornerRadius="14"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            TextColor="{DynamicResource PrimaryColor}" />

                        <Button
                            Grid.Column="1"
                            Text="Xác nhận"
                            Command="{Binding ConfirmQuickJumpCommand}"
                            HeightRequest="44"
                            CornerRadius="14"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="#FFFFFF" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ================= POPUP CÀI ĐẶT GIAO DIỆN, MÀU SẮC & HÌNH NỀN (THEME) ================= -->
        <Grid
            Grid.RowSpan="2"
            BackgroundColor="#66000000"
            IsVisible="{Binding IsThemePopupOpen}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseThemePopupCommand}" />
            </Grid.GestureRecognizers>

            <Border
                Margin="18,24"
                Padding="18"
                MaximumHeightRequest="640"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                Stroke="{DynamicResource PrimaryBorderColor}"
                StrokeThickness="1.5"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="🎨 Giao diện, Màu sắc &amp; Hình nền"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryTextColor}" />
                                <Label
                                    Text="Tùy chỉnh Sáng/Tối, màu chủ đạo và hình nền cá nhân"
                                    FontSize="11"
                                    TextColor="{DynamicResource SecondaryTextColor}" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                WidthRequest="32"
                                HeightRequest="32"
                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseThemePopupCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="✕"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                        </Grid>

                        <!-- Công tắc Chế độ Ban đêm (Dark Mode) -->
                        <Border
                            Padding="12,8"
                            BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                            Stroke="{DynamicResource PrimaryBorderColor}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label
                                        Text="🌙 Chế độ Ban đêm (Dark Mode)"
                                        FontSize="13.5"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Label
                                        Text="Nền đen khói sang trọng, dịu mắt"
                                        FontSize="11"
                                        TextColor="{DynamicResource SecondaryTextColor}" />
                                </VerticalStackLayout>
                                <Switch
                                    Grid.Column="1"
                                    IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                                    OnColor="{DynamicResource PrimaryBorderColor}"
                                    ThumbColor="{DynamicResource PrimaryColor}" />
                            </Grid>
                        </Border>

                        <!-- Bảng mã màu gợi ý sang trọng -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Bảng màu chủ đạo gợi ý:"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SecondaryTextColor}" />

                            <FlexLayout
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding ThemePresets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThemePresetItem">
                                        <Border
                                            Margin="0,3,6,3"
                                            Padding="10,6"
                                            BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                                            Stroke="{DynamicResource SubtleBorderColor}"
                                            StrokeThickness="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding SelectCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Ellipse
                                                    WidthRequest="13"
                                                    HeightRequest="13"
                                                    Fill="{Binding PreviewColor}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="11.5"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource PrimaryTextColor}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Nhập mã màu Hex trực tiếp -->
                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="Mã màu Hex tùy chỉnh (vd: #800020, #1A365D):"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SecondaryTextColor}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Border
                                    Grid.Column="0"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                                    Stroke="{DynamicResource PrimaryBorderColor}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Entry
                                        Text="{Binding CustomHexInput, Mode=TwoWay}"
                                        ReturnCommand="{Binding ApplyCustomHexThemeCommand}"
                                        Placeholder="#800020"
                                        PlaceholderColor="#9E9E9E"
                                        FontSize="13.5"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryTextColor}" />
                                </Border>

                                <Button
                                    Grid.Column="1"
                                    Text="Áp dụng"
                                    Command="{Binding ApplyCustomHexThemeCommand}"
                                    HeightRequest="40"
                                    Padding="14,0"
                                    CornerRadius="12"
                                    FontSize="12.5"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="#FFFFFF" />
                            </Grid>

                            <Label
                                Text="{Binding ThemeErrorMessage}"
                                FontSize="11"
                                TextColor="#EF4444"
                                IsVisible="{Binding HasThemeError}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{DynamicResource SubtleBorderColor}" />

                        <!-- Khu vực Hình nền ứng dụng (Custom Wallpaper & Opacity) -->
                        <Border
                            Padding="12,10"
                            BackgroundColor="{DynamicResource PrimaryCardTintColor}"
                            Stroke="{DynamicResource PrimaryBorderColor}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="1">
                                        <Label
                                            Text="🖼️ Hình nền ứng dụng"
                                            FontSize="13.5"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryTextColor}" />
                                        <Label
                                            Text="{Binding WallpaperStatusText}"
                                            FontSize="11"
                                            TextColor="{DynamicResource SecondaryTextColor}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Nút Chọn ảnh từ thiết bị & Xóa hình nền -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="0"
                                        Text="📷 Chọn ảnh từ thiết bị"
                                        Command="{Binding PickWallpaperCommand}"
                                        HeightRequest="40"
                                        CornerRadius="12"
                                        FontSize="12.5"
                                        FontAttributes="Bold"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="#FFFFFF" />

                                    <Button
                                        Grid.Column="1"
                                        Text="🗑️ Xóa nền"
                                        Command="{Binding ClearWallpaperCommand}"
                                        IsVisible="{Binding HasWallpaper}"
                                        HeightRequest="40"
                                        Padding="12,0"
                                        CornerRadius="12"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                </Grid>

                                <!-- Tùy chọn căn chỉnh (Aspect: AspectFill, AspectFit, Fill) -->
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Chế độ căn chỉnh ảnh (Aspect):"
                                        FontSize="11.5"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource SecondaryTextColor}" />

                                    <FlexLayout
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding WallpaperAspects}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:WallpaperAspectItem">
                                                <Border
                                                    Margin="0,2,6,2"
                                                    Padding="10,6"
                                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                                    Stroke="{DynamicResource SubtleBorderColor}"
                                                    StrokeThickness="1">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger
                                                            TargetType="Border"
                                                            Binding="{Binding IsSelected}"
                                                            Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding SelectCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label
                                                        Text="{Binding Label}"
                                                        FontSize="11.5"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryTextColor}">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding IsSelected}"
                                                                Value="True">
                                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>

                                <!-- Thanh trượt (Slider) điều chỉnh độ mờ đục (Opacity: 0.05 -> 0.9, mặc định 0.2) -->
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Label
                                            Grid.Column="0"
                                            Text="Độ rõ hình nền (Opacity: 0.05 - 0.90):"
                                            FontSize="11.5"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource SecondaryTextColor}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding WallpaperOpacityPercentText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Grid>

                                    <Slider
                                        Minimum="0.05"
                                        Maximum="0.9"
                                        Value="{Binding WallpaperOpacity, Mode=TwoWay}"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        ThumbColor="{DynamicResource PrimaryColor}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
