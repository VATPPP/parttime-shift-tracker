<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ShiftTracker.App.Controls.AppWallpaperBackground"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    InputTransparent="True"
    CascadeInputTransparent="True">

    <!-- Lớp 1 (dưới cùng): Nền màu hệ thống (Đen #121212 cho Dark Mode, Trắng #FFFFFF cho Light Mode) -->
    <!-- Lớp 2 (ở giữa): Image hiển thị hình nền tùy chọn với Opacity và Aspect liên kết từ ThemeService -->
    <Grid
        BackgroundColor="{DynamicResource AppBackgroundColor}"
        InputTransparent="True"
        CascadeInputTransparent="True">
        <Image
            Source="{DynamicResource WallpaperSource}"
            Aspect="{DynamicResource WallpaperAspect}"
            Opacity="{DynamicResource WallpaperOpacity}"
            IsVisible="{DynamicResource HasWallpaper}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />
    </Grid>
</ContentView>

